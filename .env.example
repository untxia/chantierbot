GROQ_API_KEY=your_key_here
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
# Server-only secret: never expose this as PUBLIC_. Required for admin user deletion/ban.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Tests de bout en bout : compte de test dédié (ne jamais utiliser un vrai compte)
E2E_EMAIL=
E2E_PASSWORD=
# Facultatif : E2E_BASE_URL (défaut http://localhost:5199), CHROME_PATH
